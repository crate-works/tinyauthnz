extends ../index

prepend head
  - const title = "Users"
  //- instant refresh after adding a newUser clears the form submission
  //- so the user can refresh the page without being prompted to resubmit
  if newUser
    meta(http-equiv="refresh" content="0;url=?")

block main
  h1 User management
  table
    tr
      th
      th Username
      th Name
      th Actions
    each user in users
      tr(class=`${user.id === newUser ? 'new' : ''}`)
        td
          if user.applications.length > 0
            | (#{user.applications.length})
        td #{user.username}
        td #{user.full_name}
        td: +action("View", `View ${user.full_name}'s account`, `/users/${user.id}`, "get")
          .pending-applications 
    else
      tr: td(colspan=4) There are no users.
    tr: td(colspan=4)
      +popover("create-user", "+ Add new user")
        form(method="post" action=`/users`)
          label Username (lowercase; no spaces)
            input(type="text" name="username" pattern="[a-z]+")
          label Full name
            input(type="text" name="full_name")
          button Submit
  
